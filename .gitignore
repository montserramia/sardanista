# --- Sistemes i editors ---
.DS_Store
__MACOSX/
.idea/
.vscode/
*.swp
*~

# --- Composer / Drupal ---
/drupal11/vendor/
/drupal11/web/sites/default/files/*
!/drupal11/web/sites/default/files/.gitkeep
/drupal11/web/sites/default/settings.local.php
/drupal11/web/sites/default/settings.php
/drupal11/web/sites/default/services.yml

# --- Backups / dumps ---
/backup-db.sh
/restore-db.sh
/backups/
*backup*.sql
*backup*.gz
*.tar.gz
*.sql

# --- Node / React ---
/node_modules/
/frontend-sardanista/node_modules/
/frontend-sardanista/build/

# Mantén lockfiles versionats!
# (no ignorem package-lock.json ni composer.lock)

# --- Eines / temporals ---
/bfg.jar
/sardanista.git/
/sardanista.git.bfg-report/
/drupal11/drush.phar
/drupal11/drush83
/drupal11/web/index.php.bak
/drupal11/web/sites/default/settings.php.backup
/drupal11/web/.well-known/

